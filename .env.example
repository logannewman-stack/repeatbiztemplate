# ==========================================================================
# REPEAT BIZ TEMPLATE — environment
# Copy to `.env.local` for local dev; paste the same keys into Vercel.
# Nothing here is real. Every value is a placeholder.
# ==========================================================================

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_SLUG=example-studio

# --- Supabase -------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_anon_key
# Server-only. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_key
# Only needed for `npm run db:seed` against a hosted project.
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Stripe ---------------------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# From `stripe listen` locally, or the endpoint's signing secret in prod.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Optional: Stripe Tax / customer portal configuration id
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Messaging (optional; adapters no-op until filled in) -----------------
# Email — Resend
RESEND_API_KEY=
EMAIL_FROM="123 Example Studio <hello@example-studio.test>"
# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Cron -----------------------------------------------------------------
# Random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=REPLACE_ME_random_string

# --- Feature flags --------------------------------------------------------
# Set to `false` to hard-disable a revenue module for a given client build.
NEXT_PUBLIC_FEATURE_MEMBERSHIPS=true
NEXT_PUBLIC_FEATURE_PACKAGES=true
NEXT_PUBLIC_FEATURE_GIFT_CARDS=true
NEXT_PUBLIC_FEATURE_RETAIL=true
NEXT_PUBLIC_FEATURE_WAITLIST=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_REFERRALS=true
NEXT_PUBLIC_FEATURE_TIPS=true
